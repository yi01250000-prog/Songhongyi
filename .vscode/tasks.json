{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "启动服务",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe app.py",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "运行测试",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m unittest discover -s tests -t . -v",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "生成演示日志",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe scripts\\generate_sample_log.py",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "性能基准测试",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe scripts\\benchmark.py",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
